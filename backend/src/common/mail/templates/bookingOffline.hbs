    </style>
  </head>

  <body>
    <table role='presentation' class='body' bgcolor='#f6f6f6'>
      <tr>
        <td>&nbsp;</td>
        <td class='container' width='580' valign='top'>
          <div class='content'>
            <!-- START CENTERED WHITE CONTAINER -->
            <table role='presentation' class='main'>
              <!-- HEADER -->
              <tr>
                <td class='header-box' valign='top'>
                  <div class='header-icon'>✓</div>
                  <h5><strong>Lịch hẹn đã được xác nhận</strong></h5>
                </td>
              </tr>
              <!-- START MAIN CONTENT AREA -->
              <tr>
                <td class='wrapper' valign='top'>
                  <table role='presentation'>
                    <tr>
                      <td valign='top'>
                        <div style='text-align: center;'>
                          <span class='confirmed-badge'>✓ ĐÃ XÁC NHẬN</span>
                        </div>

                        <p>Xin chào <strong>{{patientName}}</strong>,</p>

                        <!-- Success Message -->
                        <div class='success-message'>
                          <h6>🎉 Tuyệt vời!</h6>
                          <p>Bác sĩ <strong>{{doctorName}}</strong> đã xác nhận lịch hẹn của bạn.</p>
                          <p>Chúng tôi rất mong được gặp bạn!</p>
                        </div>

                        <!-- Appointment Details -->
                        <div class='appointment-card'>
                          <h6>📋 Thông tin lịch khám</h6>

                          <div class='detail-row'>
                            <span class='icon'>👨‍⚕️</span>
                            <div class='content'>
                              <span class='label'>Bác sĩ</span>
                              <span class='value'>{{doctorName}}</span>
                            </div>
                          </div>

                          <div class='detail-row'>
                            <span class='icon'>🕐</span>
                            <div class='content'>
                              <span class='label'>Thời gian</span>
                              <span class='value'>{{time}} - {{date}}</span>
                            </div>
                          </div>

                          <div class='detail-row'>
                            <span class='icon'>📍</span>
                            <div class='content'>
                              <span class='label'>Địa điểm</span>
                              <span class='value'>{{address}}</span>
                            </div>
                          </div>

                          <div class='detail-row'>
                            <span class='icon'>🏥</span>
                            <div class='content'>
                              <span class='label'>Hình thức khám</span>
                              <span class='value'>{{appointmentType}}</span>
                            </div>
                          </div>

                          <div class='detail-row'>
                            <span class='icon'>💰</span>
                            <div class='content'>
                              <span class='label'>Chi phí</span>
                              <span class='value'>{{price}} VNĐ</span>
                            </div>
                          </div>
                        </div>

                        <!-- Add to Calendar -->
                        <div class='calendar-section'>
                          <p style='margin: 0 0 15px 0; color: #1976D2;'><strong>Lưu lịch hẹn vào Calendar</strong></p>
                          <p style='font-size: 13px; color: #666; margin-bottom: 15px;'>Nhận nhắc nhở tự động trước khi đến lịch hẹn</p>
                          <a href='{{addToGoogleCalendarUrl}}' class='btn-add-calendar'>+ Google Calendar</a>
                          <a href='{{addToOutlookCalendarUrl}}' class='btn-add-calendar'>+ Outlook</a>
                        </div>

                        <!-- Important Reminders -->
                        <div class='reminders-box'>
                          <h6>Lưu ý quan trọng</h6>

                          <div class='reminder-item'>
                            <p><strong>Đến sớm 10-15 phút</strong></p>
                            <p style='font-size: 13px;'>Để hoàn tất thủ tục và không làm trễ lịch khám</p>
                          </div>

                          <div class='reminder-item'>
                            <p><strong>Mang theo giấy tờ</strong></p>
                            <p style='font-size: 13px;'>CMND/CCCD, thẻ bảo hiểm y tế (nếu có), hồ sơ bệnh án cũ</p>
                          </div>

                          <div class='reminder-item'>
                            <p><strong>Danh sách thuốc đang dùng</strong></p>
                            <p style='font-size: 13px;'>Mang theo đơn thuốc hoặc danh sách các loại thuốc bạn đang sử dụng</p>
                          </div>

                          <div class='reminder-item'>
                            <p><strong>Thay đổi lịch hẹn</strong></p>
                            <p style='font-size: 13px;'>Vui lòng thông báo trước ít nhất 24 giờ nếu cần hủy hoặc đổi lịch</p>
                          </div>
                        </div>

                        <!-- Contact Information -->
                        <div class='contact-box'>
                          <p><strong>Cần hỗ trợ?</strong></p>
                          <p>Hotline: <strong>0835090938</strong></p>
                          <p>Email: <strong>phamthiendong2004@gmail.com</strong></p>
                          <p style='font-size: 12px; margin-top: 10px;'>Làm việc: Thứ 2 - Thứ 7 (8:00 - 20:00)</p>
                        </div>

                        <p style='font-size: 14px; text-align: center; color: #666; margin-top: 30px;'>
                          Chúng tôi rất mong được chăm sóc sức khỏe cho bạn!
                        </p>

                        <p style='font-size: 14px; margin-bottom: 0;'>
                          Trân trọng,
                          <br />
                          CLINIC CARE
                        </p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <!-- END MAIN CONTENT AREA -->
            </table>
            <!-- END CENTERED WHITE CONTAINER -->

            <!-- START FOOTER -->
            <div class='footer'>
              <table role='presentation'>
                <tr>
                  <td class='footer-text'>
                    <p style='margin: 0;'>Email này được gửi từ <strong>no-reply@npis.com</strong></p>
                  </td>
                </tr>
                <tr>
                  <td class='footer-address' valign='top' align='center'>
                    <span class='apple-link'>120, Hoàng Minh Thảo, Đà Nẵng, Việt Nam</span>
                  </td>
                </tr>
                <tr>
                  <td class='footer-copyright'>
                    <p style='margin: 0;'>Copyright &copy; 2025 <b>CLINIC CARE</b>, All Rights Reserved.</p>
                  </td>
                </tr>
              </table>
            </div>
            <!-- END FOOTER -->
          </div>
        </td>
        <td valign='top'>&nbsp;</td>
      </tr>
    </table>
  </body>
</html>

